{
  "name": "shrinkarr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "start": "node server/dist/cli/index.js start",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm run test -w server && npm run test -w web",
    "bench": "npm run bench -w server",
    "dev:server": "npm run dev -w server",
    "lint": "eslint server/src server/test server/bench web/src"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "puppeteer-core": "25.16.0",
    "typescript-eslint": "8.72.1"
  }
}
